Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: cloud_registered
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic: /cloud_registered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: fitted_path
      Topic: /radar_curve_planner/fitted_path
      Unreliable: false
      Value: true
    - Class: rviz/Path
      Color: 0; 255; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: mid_points_path
      Topic: /radar_curve_planner/mid_points
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /radar_curve_planner/midpoint_markers
      Name: midpoint_markers
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /radar_curve_planner/curve_markers
      Name: curve_markers
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: yaml_path
      Topic: /radar_curve_planner/yaml_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /radar_curve_planner/yaml_markers
      Name: yaml_markers
      Namespaces:
        {}
      Queue Size: 100
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: -2
        Y: -1.5
        Z: 1
      Name: Current View
      Pitch: 0.9
      Target Frame: camera_init
      Yaw: 0.7
Window Geometry:
  Height: 900
  Width: 1200
